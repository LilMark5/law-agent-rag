# 复制为 .env 后填入真实值：cp .env.example .env
# 优先级：.env > 系统环境变量 > config/settings.yaml
#   （.env 优先，是为了避免"系统里残留一个旧 Key 悄悄覆盖 .env"这种极难排查的问题；
#     若两者不一致，启动时会打印一行警告说明哪个生效。）

# ---- 必需：对话生成 ----
# 获取：https://platform.deepseek.com/api_keys
# 缺失时 /api/chat 会在生成节点报错，但检索链路仍可单独验证。
DEEPSEEK_API_KEY=

# ---- 可选：向量检索（Embedding）----
# 获取：https://bailian.console.aliyun.com/ → 右上角设置 → API-KEY → 创建
#   注意：必须是「API-KEY」页面创建的 sk- 开头字符串，
#        阿里云的 AccessKey ID / Secret 不能用于此处。
# 缺失时 hybrid 检索自动降级为 BM25 + 图谱，不影响服务启动。
# 换供应商只改 config/settings.yaml 的 embedding.base_url / model（任意 OpenAI 兼容服务）。
DASHSCOPE_API_KEY=

# ---- 必需：知识图谱 ----
# 必须与 docker-compose.yml 中 NEO4J_AUTH 的密码一致。
# 本地默认值沿用旧密码，避免已初始化的图谱数据卷认证失败；全新环境可自行更换。
NEO4J_PASSWORD=law_agent_rag_2026

# ---- 可选：端口（默认 8200 / 3200，避开本机其它项目的 8000 / 8100）----
# 后端：API_PORT 只影响 `python backend/main.py` 这条启动路径；
#       用 uvicorn CLI 时以 --port 为准（命令手册里已写 8200）。
# 前端：dev 端口在 frontend/package.json 的 dev 脚本里（next dev -p 3200）。
#       BACKEND_ORIGIN 控制 Next 把 /api/* 代理到哪个后端，默认已是 8200，
#       一般不用设。若确实要改，Next 只读 frontend/.env.local 或系统环境变量，
#       读不到仓库根目录这份 .env —— 在 frontend/.env.local 里写才生效。
API_PORT=8200
FRONTEND_PORT=3200
BACKEND_ORIGIN=http://127.0.0.1:8200
